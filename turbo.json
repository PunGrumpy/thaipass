{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["AIPASS_*", "POSTHOG_*", "VERCEL"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": ["AIPASS_*", "POSTHOG_*", "VERCEL"]
    }
  }
}
