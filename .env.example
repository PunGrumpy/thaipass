# Copy to ~/.config/aipass-proxy.env (chmod 600) and fill in AIPASS_COOKIE.
# The proxy reads this file ITSELF (dotenv-style) -- never `source` it in a shell,
# because the cookie contains `;` and spaces that a shell would split.

# Full Cookie header value, including __Secure-ai_passport_auth.session_token.
AIPASS_COOKIE=""

# Optional overrides.
AIPASS_ORIGIN="https://de.aipass.net"
AIPASS_HOST="127.0.0.1"
AIPASS_PORT="3789"
