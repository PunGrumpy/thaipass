{
  "name": "@thaipass/proxy",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible /v1/chat/completions and Anthropic-compatible /v1/messages in front of the AI Pass (de.aipass.net) chat backend.",
  "bin": {
    "aipass-lms": "src/lms/cli.ts",
    "aipass-login": "src/login/cli.ts",
    "aipass-proxy": "src/server.ts",
    "aipass-workspace": "src/workspace/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build": "tsdown",
    "build:worker": "bun scripts/build-worker.ts",
    "deploy:worker": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "lms": "bun run src/lms/cli.ts",
    "workspace": "bun run src/workspace/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "login": "bun run src/login/cli.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "2.0.0-exp.0",
    "@t3-oss/env-core": "0.13.11",
    "elysia": "2.0.0-exp.64",
    "evlog": "2.28.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@thaipass/core": "workspace:*",
    "@types/bun": "1.4.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
