{
  "name": "aipass-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible /v1/chat/completions proxy in front of the AI Pass (de.aipass.net) chat backend.",
  "bin": {
    "aipass-lms": "src/lms/cli.ts",
    "aipass-proxy": "src/server.ts"
  },
  "type": "module",
  "module": "src/server.ts",
  "exports": {
    "./provider": "./src/provider/aipass.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "lms": "bun run src/lms/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "3.0.36",
    "@elysiajs/openapi": "2.0.0-exp.0",
    "@t3-oss/env-core": "0.13.11",
    "elysia": "2.0.0-exp.64",
    "evlog": "2.28.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  }
}
